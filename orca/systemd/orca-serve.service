# orca-setup: Orca server for this user
# Rendered by `./setup.sh --apply --role server` from orca/systemd/orca-serve.service (README section 3.3.2);
# rerun it to change the unit instead of editing this file. The first line marks the unit as orca-setup's.
# --no-pairing: the service never creates a pairing offer, so nothing secret can reach the journal.
# Pair a client from an interactive terminal instead (README section 3.3.2).
[Unit]
Description=Orca server (orca-ide serve --supervise), managed by orca-setup
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@ORCA_IDE@ serve --supervise --no-pairing --port @PORT@ --pairing-address @PAIRING_ADDRESS@
Environment=PATH=%h/.local/bin:%h/.grok/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
@ENVIRONMENT@
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
# Stop only the supervisor: it stops its server while the terminal daemon and its sessions keep running.
KillMode=process

[Install]
WantedBy=default.target
