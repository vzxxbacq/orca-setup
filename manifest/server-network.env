# Isolated Linux server networking defaults. Override only these keys in manifest/local/server-network.env.
# This is data, never shell code. No inline credentials, URLs, subscriptions or SS keys are accepted.
# The upstream HTTP CONNECT or SOCKS5 endpoint must already be running and reachable from a container.
proxy_type=socks5
proxy_address=
proxy_port=1080
# Optional external root-owned mode-0600 JSON file with username/password, mounted only into orca-gateway.
# setup.sh never reads or copies its contents. Provision it separately on the target device, outside the checkout.
proxy_auth_file=
# Orca DNS uses certificate-verified DNS-over-HTTPS through the proxy, avoiding blocked upstream TCP/53.
dns_address=1.1.1.1
dns_transport=https
dns_tls_name=cloudflare-dns.com
# Empty: the executor has no external DNS. Otherwise a private resolver; only TCP/UDP 53 is allowed to it.
executor_dns=
# Dedicated Docker control network, not a LAN range. Change it if it overlaps an existing route.
control_subnet=172.30.70.0/24
