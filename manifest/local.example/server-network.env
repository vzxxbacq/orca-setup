# Used only with --network-mode isolated. Replace this documentation address with your existing proxy's IPv4.
proxy_type=socks5
proxy_address=192.0.2.20
proxy_port=1080
# Optional reference to a separately provisioned root-owned mode-0600 JSON file, outside this checkout:
# proxy_auth_file=/etc/orca-setup/proxy-auth.json
# For an HTTP proxy, set proxy_type=http-connect and its listening port.
# Optional private DNS server for the executor (empty disables external DNS).
executor_dns=
