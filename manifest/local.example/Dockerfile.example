# Organization-specific tools for the Linux server (DESIGN.md section 3.3.2). Renamed to manifest/local/Dockerfile,
# setup.sh builds it on top of the locked Orca server image (ORCA_SERVER_IMAGE) and runs the result instead. Files
# next to it in manifest/local/ are its build context. The container runs as your user without sudo, so install
# everything here, system-wide.
ARG ORCA_SERVER_IMAGE
FROM ${ORCA_SERVER_IMAGE}
USER root
# RUN apt-get update && apt-get install -y --no-install-recommends example-cli && rm -rf /var/lib/apt/lists/*
